{
  "name": "azone-workspace",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:azone": "pnpm --filter azoneofficial dev",
    "dev:elfia": "pnpm --filter elfia dev",
    "build:azone": "pnpm --filter azoneofficial build",
    "build:elfia": "pnpm --filter elfia build",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "worker:deploy": "pnpm --filter worker deploy",
    "worker:migrate": "pnpm --filter worker migrate:prod"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.0"
  }
}
