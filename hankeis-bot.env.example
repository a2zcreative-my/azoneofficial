# Hankei's Telegram adapter - environment example.
#
# EVERY VALUE HERE IS A PLACEHOLDER. There are no real secrets in this file
# and none may ever be committed into it. Copy it to .env (which is not
# tracked) or load these into your platform's secret manager.
#
# This file belongs to the BOT, which runs on Astra's side. The portal worker
# itself needs NO new environment variable for Hankei's: it uses the D1 and R2
# bindings it already has, and integration tokens live hashed in the database,
# not in the environment.

# ─────────────────────────────────────────────────────────────────────────
# The portal's integration surface
# ─────────────────────────────────────────────────────────────────────────

# Base URL. Use a preview deployment while you build - live mode creates real
# orders in whatever database the worker is bound to.
HANKEIS_API_BASE=https://example.invalid/api/v1/hankeis

# The integration bearer token. Minted in the portal by the owner:
#   Hankei's -> Settings -> integration credentials
# It is shown ONCE; only its SHA-256 hash is stored. If it leaks, revoke it
# there and mint another - a leaked token cannot be "rotated" by editing it
# here.
#
# It cannot verify a payment, change a price, set a customer category or read
# another customer's order. There is no endpoint for any of that.
HANKEIS_API_TOKEN=hk_replace_me_with_the_token_minted_in_the_portal

# Space-separated, for your own sanity check against what the token was
# granted. The server enforces the real list; this is documentation.
HANKEIS_API_SCOPES=catalogue customers orders receipts status events

# ─────────────────────────────────────────────────────────────────────────
# Telegram - yours, and only yours
# ─────────────────────────────────────────────────────────────────────────

# The portal has no field for this, never receives it and never calls
# Telegram. Keep it on the bot's side.
TELEGRAM_BOT_TOKEN=000000000:replace_me_with_the_token_from_BotFather

# The secret you set on setWebhook, checked against the
# X-Telegram-Bot-Api-Secret-Token header on every incoming update. Generate it
# locally, e.g.  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_me_generate_locally_never_paste_in_chat

# ─────────────────────────────────────────────────────────────────────────
# Outbox consumer
# ─────────────────────────────────────────────────────────────────────────

# How often to POST /events/claim. Every 5-15 seconds is plenty.
HANKEIS_POLL_SECONDS=10

# Events per claim (server caps at 50) and how long a claim is held before it
# returns to the queue (server clamps to 10-600).
HANKEIS_CLAIM_LIMIT=20
HANKEIS_CLAIM_VISIBILITY_SECONDS=60

# Where your consumer records the event_ids it has already delivered.
# Delivery is AT-LEAST-ONCE: without this, a redelivered event sends the
# customer a second message.
HANKEIS_DELIVERED_STORE=./delivered-event-ids.db
